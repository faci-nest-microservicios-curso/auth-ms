# Dependencias
FROM node:24-alpine3.24 as deps

WORKDIR /usr/src/app

COPY package.json ./
COPY package-lock.json ./

RUN npm install



# Builder - Construye la aplicación
FROM node:24-alpine3.24 as build

# Prisma 5.10 no detecta OpenSSL en Alpine 3.24 sin el binario `openssl`.
RUN apk add --no-cache openssl

WORKDIR /usr/src/app

# Copiar de deps, los módulos de node
COPY --from=deps /usr/src/app/node_modules ./node_modules

# Copiar todo el codigo fuente de la aplicación
COPY . .

# RUN npm run test
RUN npm run build

# Generar el cliente Prisma con la versión fijada en devDependencies (5.10.2).
# Se hace ANTES de podar: `npm ci --only=production` borraría node_modules/.prisma.
RUN npx prisma generate

RUN npm prune --omit=dev && npm cache clean --force



# Crear la imagen final de Docker
FROM node:24-alpine3.24 as prod

# Prisma necesita `openssl` también en runtime para detectar el target
# linux-musl-openssl-3.0.x (si no, busca el engine `linux-musl` y falla).
RUN apk add --no-cache openssl

WORKDIR /usr/src/app

COPY --from=build /usr/src/app/node_modules ./node_modules

# Copiar la carpeta de DIST
COPY --from=build /usr/src/app/dist ./dist


ENV NODE_ENV=production

USER node

EXPOSE 3000

CMD [ "node", "dist/main.js" ]
